{
    "name": "@virmator/test",
    "version": "14.7.2",
    "description": "Default test plugin for virmator.",
    "keywords": [
        "virmator",
        "test",
        "node",
        "web",
        "browser"
    ],
    "homepage": "https://github.com/electrovir/virmator",
    "bugs": {
        "url": "https://github.com/electrovir/virmator/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/virmator.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/test.ts",
    "module": "src/test.ts",
    "types": "src/test.ts",
    "scripts": {
        "compile": "virmator compile",
        "test": "runstorm --names node,web \"npm run test:node\" \"npm run test:web\"",
        "test:coverage": "npm test",
        "test:node": "virmator test node src/test.test.ts src/web-snapshot-plugin/snapshot-store.test.ts",
        "test:update": "virmator test node update src/test.test.ts src/web-snapshot-plugin/snapshot-store.test.ts",
        "test:web": "npm run compile && virmator test web src/web-snapshot-plugin/web-snapshot-plugin.test.ts src/web-screenshot-plugin/web-screenshot-plugin.test.ts"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.64.0",
        "@augment-vir/common": "^31.64.0",
        "@augment-vir/node": "^31.64.0",
        "@virmator/core": "^14.7.2",
        "@web/dev-server-core": "^0.7.5",
        "@web/test-runner-core": "^0.13.4",
        "glob": "^13.0.6",
        "mri": "^1.2.0",
        "object-shape-tester": "^6.11.0",
        "pixelmatch": "^7.1.0",
        "pngjs": "^7.0.0",
        "sharp": "^0.34.5",
        "typed-event-target": "^4.1.0"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.64.0",
        "@open-wc/testing": "^4.0.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.3.0",
        "@web/dev-server-esbuild": "^1.0.5",
        "@web/test-runner": "^0.20.2",
        "@web/test-runner-commands": "^0.9.0",
        "@web/test-runner-playwright": "^0.11.1",
        "c8": "^10.1.3",
        "element-vir": "^26.14.3",
        "istanbul-smart-text-reporter": "^1.1.5",
        "runstorm": "^1.0.0",
        "tsx": "^4.21.0"
    },
    "peerDependencies": {
        "@web/test-runner-commands": "*",
        "@web/test-runner-visual-regression": "*"
    },
    "engines": {
        "node": ">=22"
    },
    "publishConfig": {
        "access": "public"
    }
}
